# ══════════════════════════════════════════════════════════════════════════════
# LOCAL DEV — copy this to .env.local
# Used by Next.js dev server on your WSL / Windows machine
# ══════════════════════════════════════════════════════════════════════════════

# ── Convex self-hosted backend (WSL Docker) ───────────────────────────────────
# WSL2 auto-forwards ports: localhost:3210 reaches the Convex container in WSL
NEXT_PUBLIC_CONVEX_URL="http://localhost:3210"

# Server-side HTTP client (same URL for local dev — no Docker network here)
CONVEX_URL="http://localhost:3210"

# Admin key for schema push (must match CONVEX_LOCAL_ADMIN_KEY in docker-compose)
CONVEX_ADMIN_KEY="insecure-local-admin-key-change-me"

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET="dev-only-secret-replace-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# ── Other services (optional for local dev) ───────────────────────────────────
# DATABASE_URL="postgresql://dict_user:password@localhost:5432/dict_db"
# GROQ_API_KEY="gsk_..."
# CLOUDINARY_CLOUD_NAME=""
