# ══════════════════════════════════════════════════════════════════════════════
# LOCAL DEV — copy this to .env.local
# Used by Next.js dev server on your WSL / Windows machine
# ══════════════════════════════════════════════════════════════════════════════

# ── Convex self-hosted backend (DICT server — WSL Docker) ────────────────────
# On the DICT server itself (localhost forwards to WSL via WSL2 auto-port-forward):
NEXT_PUBLIC_CONVEX_URL="http://localhost:3210"
CONVEX_URL="http://localhost:3210"

# On another PC connecting over LAN (replace with actual WSL host IP):
# NEXT_PUBLIC_CONVEX_URL="http://172.29.22.164:3210"
# CONVEX_URL="http://172.29.22.164:3210"

# Admin key — find in .env on the DICT server (CONVEX_ADMIN_KEY line)
# Format: dict-logbook|<hex-string>
CONVEX_ADMIN_KEY="dict-logbook|0148a0a3327106b27ba6655d0a44ab4a07434f23e4df8f8500442bc520590bc96cb6f1a21b"

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET="dev-only-secret-replace-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# ── Other services (optional for local dev) ───────────────────────────────────
# DATABASE_URL="postgresql://dict_user:password@localhost:5432/dict_db"
# GROQ_API_KEY="gsk_..."
# CLOUDINARY_CLOUD_NAME=""
