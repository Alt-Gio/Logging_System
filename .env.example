# ══════════════════════════════════════════════════════════════════════════════
# DICT DTC Logbook — Environment Variables
# Copy this to .env for Docker Compose, or .env.local for local dev
# Lines marked REQUIRED must be set before the app will start in production
# ══════════════════════════════════════════════════════════════════════════════

# ── Convex Database (PRIMARY — self-hosted via WSL Docker) ──────────────────
# NEXT_PUBLIC_CONVEX_URL — browser-accessible URL, baked into JS bundle at build time
#   Local dev (WSL):    http://localhost:3210
#   LAN / other PC:     http://<host-machine-ip>:3210
#   Docker + SSL nginx: https://<your-domain>:3210
NEXT_PUBLIC_CONVEX_URL="http://localhost:3210"

# CONVEX_URL — server-side only (API routes, layout); uses Docker internal hostname in prod
#   Local dev:  http://localhost:3210
#   Docker:     http://convex-backend:3210  (set automatically in docker-compose)
CONVEX_URL="http://localhost:3210"

# CONVEX_ADMIN_KEY — must match CONVEX_LOCAL_ADMIN_KEY in docker-compose.yml
# Change this to a secure random string in production
CONVEX_ADMIN_KEY="insecure-local-admin-key-change-me"

# ── Custom JWT Authentication ────────────────────────────────────────────────
# REQUIRED — Secret used to sign/verify dict-session JWT cookies
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-32+-char-random-string"

# ── First Admin Seed ──────────────────────────────────────────────────────────
# Used only by PUT /api/auth when no admin accounts exist yet
# Remove after initial setup
SETUP_TOKEN="replace-with-secure-setup-token"

# ── Groq AI (Voice Assistant) ─────────────────────────────────────────────────
# REQUIRED for voice chatbot — Get from console.groq.com
GROQ_API_KEY="gsk_..."

# ── Pusher — DEPRECATED (replaced by Convex real-time) ───────────────────────
# These are no longer needed. Convex useQuery() handles real-time automatically.
# PUSHER_APP_ID="your_app_id"
# PUSHER_KEY="your_key"
# PUSHER_SECRET="your_secret"
# PUSHER_CLUSTER="ap1"
# NEXT_PUBLIC_PUSHER_KEY="your_key"
# NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ── Cloudinary (photo CDN) — free tier at cloudinary.com ─────────────────────
# OPTIONAL — without these, photos stored as base64 in DB
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Resend (Email) — free tier at resend.com ─────────────────────────────────
# REQUIRED for sending emails to interns
RESEND_API_KEY="re_..."
EMAIL_FROM="DTC Region V <noreply@yourdomain.com>"

# ── Twilio (SMS) — free trial at twilio.com ───────────────────────────────────
# OPTIONAL — SMS notifications to interns
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ── Network Bridge Agent ──────────────────────────────────────────────────────
# OPTIONAL — Secret key for network bridge agent authentication
NETWORK_BRIDGE_KEY="replace-with-secure-random-key"

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET="replace-with-cron-secret"

# ── Docker image (CI/CD) ──────────────────────────────────────────────────────
# Set automatically by GitHub Actions
IMAGE_TAG="latest"
GITHUB_REPOSITORY="your-org/dict-logbook"

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV="production"
