# ══════════════════════════════════════════════════════════════════════════════
# DICT DTC Logbook — Environment Variables
# Copy this to .env.local for local dev, or set in Railway dashboard
# Lines marked REQUIRED must be set before the app will start in production
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"

# ── Clerk Authentication ──────────────────────────────────────────────────────
# REQUIRED — Get from clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ── Groq AI (Voice Assistant) ─────────────────────────────────────────────────
# REQUIRED for voice chatbot — Get from console.groq.com
# Supports multilingual: English, Tagalog, Bicolano
GROQ_API_KEY="gsk_..."

# ── Pusher (real-time) — free tier at pusher.com ──────────────────────────────
# OPTIONAL — without these, dashboard won't update in real-time (manual refresh still works)
PUSHER_APP_ID="your_app_id"
PUSHER_KEY="your_key"
PUSHER_SECRET="your_secret"
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY="your_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ── Cloudinary (photo CDN) — free tier at cloudinary.com ─────────────────────
# OPTIONAL — without these, photos stored as base64 in DB (less efficient)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Resend (Email) — free tier at resend.com ─────────────────────────────────
# REQUIRED for sending emails to interns — Get from resend.com dashboard
RESEND_API_KEY="re_..."
# Optional: override the From address (must be a verified Resend domain)
EMAIL_FROM="DTC Region V <noreply@yourdomain.com>"

# ── Twilio (SMS) — free trial at twilio.com ───────────────────────────────────
# OPTIONAL — used for sending SMS notifications to interns
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ── Network Bridge Agent ──────────────────────────────────────────────────────
# OPTIONAL — Secret key for network bridge agent authentication
# Generate a secure random key and set this in Railway dashboard
# Bridge agent uses this to authenticate when polling for scan requests
NETWORK_BRIDGE_KEY="Fftk7eLJYA0Rj6c4nbOpSrV3z5qsDBZK"

# ── Node environment ──────────────────────────────────────────────────────────
# Set automatically by Railway. Only change if self-hosting.
NODE_ENV="production"
